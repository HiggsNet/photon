#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled config_file
	config_load photon
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get config_file main config_file /etc/photon/config.yaml
	case "$config_file" in
		/*) ;;
		*) echo 'photon: config_file must be an absolute path' >&2; return 1 ;;
	esac
	[ -x /usr/sbin/photon ] || return 1
	[ -f "$config_file" ] || {
		echo "photon: configure $config_file before starting" >&2
		return 1
	}
	mkdir -p /run/photon/bird || return 1
	chmod 0700 /run/photon /run/photon/bird || return 1

	procd_open_instance main
	procd_set_param command /usr/sbin/photon daemon
	procd_set_param env "PHOTON_CONFIG=$config_file" \
		PHOTON_CONTROL_SOCKET=/run/photon/photon.sock \
		PATH=/usr/sbin:/usr/bin:/sbin:/bin
	procd_set_param file "$config_file" /etc/config/photon /usr/sbin/photon
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger photon
}
