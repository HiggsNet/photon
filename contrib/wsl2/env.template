# Environment variables for Photon WSL2 client.
# Copy to env.sh and fill in values.

# Path to the photon binary
export PHOTON_BIN="/path/to/higgs/build/photon"

# Your zone FQDN (from join accept)
export CLIENT_ZONE="wsl2-poc.slapaper."

# Gateway zone FQDN
export GATEWAY_ZONE="cheap-aliyun-pek.slapaper."

# Gateway IP (v4 or v6)
export GATEWAY_IP="8.152.2.95"

# Trusted root public key (from gateway admin)
export TRUSTED_ROOT_PUBLIC_KEY=""

# Overlay ID for the PoC tunnel
export OVERLAY_ID="wsl2-poc"

# Tunnel address pool (IPv4)
export TUNNEL_POOL="10.60.0.0/24"
